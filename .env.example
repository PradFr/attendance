PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database configuration
# If DATABASE_URL is left empty, embedded PostgreSQL (PGlite) will be used at ./data/attendance.db
DATABASE_URL=

# Security & Cryptography
JWT_SECRET=super_secret_university_jwt_key_2026_change_in_prod
QR_HMAC_SECRET=super_secure_rotating_qr_crypto_secret_attendance_system_2026

# Fraud Mitigation & Anti-Spoofing Parameters
GEOFENCE_DEFAULT_RADIUS_METERS=25
GPS_MAX_ALLOWED_ACCURACY_METERS=35
QR_EXPIRATION_SECONDS=20
QR_ROTATION_INTERVAL_SECONDS=15
BIOMETRIC_SIMILARITY_THRESHOLD=0.75
MAX_REALISTIC_SPEED_METERS_PER_SEC=15.0
